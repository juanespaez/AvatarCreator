# Data assets: piece artwork, reference photos of real people, and query
# photos. Images are kept local-only — never pushed to the remote. The
# folder structure itself (marked by .gitkeep) still gets committed.
pieces/**/*.png
pieces/**/*.jpg
pieces/**/*.jpeg
pieces/**/*.webp
pieces/**/*.bmp
pieces/**/*.gif
pieces/**/*.heic
refs/**/*.png
refs/**/*.jpg
refs/**/*.jpeg
refs/**/*.webp
refs/**/*.bmp
refs/**/*.gif
refs/**/*.heic
queries/**/*.png
queries/**/*.jpg
queries/**/*.jpeg
queries/**/*.webp
queries/**/*.bmp
queries/**/*.gif
queries/**/*.heic
parked/**/*.png
parked/**/*.jpg
parked/**/*.jpeg
parked/**/*.webp
parked/**/*.bmp
parked/**/*.gif
parked/**/*.heic

# Generated by the notebook at runtime (cached embeddings, FAISS indices,
# persisted manifest) — reproducible from pieces/ + refs/, not source.
_cache/
artifacts/

# Jupyter
.ipynb_checkpoints/

# Local Python environment for testing the pipeline outside Colab
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Third-party/bundled dataset dumps dropped into queries/ for testing —
# images, labels, and READMEs alike. These carry their own license/
# provenance (e.g. RAF-DB is explicitly non-commercial-research-only) and
# none of it belongs in this repo's history, unlike a lone query photo
# (already covered by extension above).
queries/CW_Dataset/
queries/Personal_Dataset/
queries/variables/

# Build output of `pip install -e .`
*.egg-info/
